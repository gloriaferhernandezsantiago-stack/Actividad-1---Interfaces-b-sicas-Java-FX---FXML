<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane hgap="15.0" vgap="12.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio1_5.PrimaryController">
   <columnConstraints>
      <ColumnConstraints minWidth="100.0" />
      <ColumnConstraints minWidth="120.0" />
      <ColumnConstraints minWidth="100.0" />
      <ColumnConstraints minWidth="140.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>
   <children>
      <Label style="-fx-font-weight: bold;" text="Control de Gastos Semanales" GridPane.columnSpan="2" />
      
      <Label text="Alimentación" GridPane.rowIndex="1" />
      <TextField fx:id="txtAlimentacion" GridPane.columnIndex="1" GridPane.rowIndex="1" />

      <Label text="Refrigerios" GridPane.rowIndex="2" />
      <TextField fx:id="txtRefrigerios" GridPane.columnIndex="1" GridPane.rowIndex="2" />

      <Label text="Transporte" GridPane.rowIndex="3" />
      <TextField fx:id="txtTransporte" GridPane.columnIndex="1" GridPane.rowIndex="3" />

      <Label text="Telefonía" GridPane.rowIndex="4" />
      <TextField fx:id="txtTelefonia" GridPane.columnIndex="1" GridPane.rowIndex="4" />

      <Label text="Otros" GridPane.rowIndex="5" />
      <TextField fx:id="txtOtros" GridPane.columnIndex="1" GridPane.rowIndex="5" />

      <Label style="-fx-font-weight: bold;" text="Estadísticas" GridPane.columnIndex="3" />
      
      <Label text="Total semanal" GridPane.columnIndex="2" GridPane.rowIndex="1" />
      <TextField fx:id="txtTotalSemanal" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1" />

      <Label text="Gasto más alto" GridPane.columnIndex="2" GridPane.rowIndex="3" />
      <TextField fx:id="txtGastoMasAlto" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="3" />

      <Button onAction="#CalcularEstadisticas" text="Calcular estadísticas" GridPane.rowIndex="6" />
      <Button onAction="#Limpiar" text="Limpiar" GridPane.columnIndex="1" GridPane.rowIndex="6" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</GridPane>