<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio1_2.PrimaryController">
    <children>
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Desglose de dinero" />
        
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Dinero:" />
                <TextField fx:id="txtDinero" prefWidth="120.0" />
                <Button onAction="#Limpiar" text="X" />
                <Button onAction="#Desglosar" text="Desglosar" />
            </children>
        </HBox>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <TextArea fx:id="txtConceptos" editable="false" prefHeight="200.0" prefWidth="200.0" />
                <TextArea fx:id="txtCantidades" editable="false" prefHeight="200.0" prefWidth="80.0" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>