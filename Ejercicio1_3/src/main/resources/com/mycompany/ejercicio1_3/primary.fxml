<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane hgap="15.0" vgap="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio1_3.PrimaryController">
   <columnConstraints>
      <ColumnConstraints minWidth="140.0" />
      <ColumnConstraints minWidth="120.0" />
      <ColumnConstraints minWidth="80.0" />
      <ColumnConstraints minWidth="150.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>
   <children>
      <Label text="Ingrese un número" />
      <TextField fx:id="txtNumero" GridPane.columnIndex="1" />
      <Button onAction="#Analizar" text="Analizar" GridPane.columnIndex="2" />
      <Button onAction="#Limpiar" text="Limpiar" GridPane.columnIndex="3" />

      <Label text="Cantidad de cifras" GridPane.rowIndex="1" />
      <TextField fx:id="txtCantCifras" GridPane.columnIndex="1" GridPane.rowIndex="1" />

      <Label text="Suma de cifras impares" GridPane.rowIndex="2" />
      <TextField fx:id="txtSumaImpares" GridPane.columnIndex="1" GridPane.rowIndex="2" />

      <Label text="Suma de cifras pares" GridPane.rowIndex="3" />
      <TextField fx:id="txtSumaPares" GridPane.columnIndex="1" GridPane.rowIndex="3" />

      <Label text="Suma total de cifras" GridPane.rowIndex="4" />
      <TextField fx:id="txtSumaTotal" GridPane.columnIndex="1" GridPane.rowIndex="4" />

      <Label text="Cifra mayor" GridPane.rowIndex="5" />
      <TextField fx:id="txtCifraMayor" GridPane.columnIndex="1" GridPane.rowIndex="5" />

      <Label text="Cifra menor" GridPane.rowIndex="6" />
      <TextField fx:id="txtCifraMenor" GridPane.columnIndex="1" GridPane.rowIndex="6" />

      <Label text="Divisores" GridPane.columnIndex="3" GridPane.rowIndex="1" />
      <TextArea fx:id="txtDivisores" prefHeight="150.0" GridPane.columnIndex="3" GridPane.rowIndex="2" GridPane.rowSpan="5" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</GridPane>